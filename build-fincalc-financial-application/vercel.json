{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/build-fincalc-financial-application/index.html" },
    { "source": "/readme", "destination": "/build-fincalc-financial-application/readme.html" },
    { "source": "/faq", "destination": "/build-fincalc-financial-application/faq.html" },
    { "source": "/privacy", "destination": "/build-fincalc-financial-application/privacy.html" },
    { "source": "/terms", "destination": "/build-fincalc-financial-application/terms.html" },
    { "source": "/llms.txt", "destination": "/build-fincalc-financial-application/llms.txt" },
    { "source": "/robots.txt", "destination": "/build-fincalc-financial-application/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/build-fincalc-financial-application/sitemap.xml" },
    { "source": "/(.*)", "destination": "/build-fincalc-financial-application/$1" }
  ]
}
